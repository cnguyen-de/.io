---
import Header from "../components/Header.astro";
import Protected from "../components/Protected.astro";
import { ADDRESS, EMAIL } from "../data/contact";
import { encode } from "../lib/protect";
import Layout from "../layouts/Layout.astro";

const details = [
  { label: "Unternehmen", value: "May Solutions UG (haftungsbeschränkt)" },
  { label: "Anschrift", value: ADDRESS, protect: true },
  { label: "Geschäftsführer", value: "Minh Chi Nguyen" },
  { label: "E-Mail", value: EMAIL, protect: true, mail: true },
  { label: "Registergericht", value: "Amtsgericht Frankfurt am Main, HRB 135446" },
  { label: "USt-IdNr.", value: "DE370068156" }
];
---

<Layout
  lang="de"
  title="Impressum – May Solutions"
  description="Impressum der May Solutions UG (haftungsbeschränkt), Frankfurt am Main.">
  <div class="flex min-h-dvh flex-col">
    <Header lang="de" home={false} />

    <main id="main" class="wrap flex-1 py-16 md:py-28">
      <a href="/de/" class="label group inline-flex items-center gap-2">
        <span class="transition-transform duration-300 group-hover:-translate-x-1">←</span> May Solutions
      </a>

      <p class="label mt-16"><b>§</b>&ensp;—&ensp;Impressum · Legal notice</p>
      <h1 class="display mt-6">Impressum</h1>

      <dl class="border-line mt-14 max-w-4xl border-b">
        {
          details.map((d) => (
            <div class="border-line grid gap-1 border-t py-5 md:grid-cols-[14rem_1fr] md:items-baseline md:gap-8">
              <dt class="label">{d.label}</dt>
              <dd class="text-lg tracking-[-0.015em]">
                {/* Address and email are shown to people but kept unreadable for scrapers. */}
                {d.mail ? (
                  <a href="#main" data-mail={encode(d.value)} class="link">
                    <Protected value={d.value} />
                  </a>
                ) : d.protect ? (
                  <Protected value={d.value} />
                ) : (
                  d.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </main>

    <footer class="wrap pb-8">
      <p class="label border-line border-t pt-6"><b>●</b>&ensp;Frankfurt am Main</p>
    </footer>
  </div>
</Layout>
