---
// The Frankfurt section, with Fig. 2: a site plan drawn from the same footprints as the skyline.
import { translations, type Locale } from "../i18n";
import { RIEDBERG, toLocal } from "../lib/geo";
import { PLAN, plan } from "../lib/skyline";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Locale;
}

const t = translations[Astro.props.lang].location;

// City-level facts only; the postal address lives on the imprint.
const facts = [
  [t.facts.base, t.facts.baseValue],
  [t.facts.region, t.facts.regionValue],
  [t.facts.languages, "Deutsch · English"]
];

// Riedbergplatz, the company's home, is pinned on the sheet: the plan reaches north to include it.
const pin = toLocal(RIEDBERG.lat, RIEDBERG.lon);

const left = (x: number) => `${(((x - PLAN.minX) / PLAN.width) * 100).toFixed(2)}%`;
const top = (z: number) => `${(((z - PLAN.minZ) / PLAN.height) * 100).toFixed(2)}%`;
const maxX = PLAN.minX + PLAN.width;
const maxZ = PLAN.minZ + PLAN.height;

// Grid lines every 500 m.
const range = (from: number, to: number) =>
  Array.from({ length: Math.floor((to - from) / 500) + 1 }, (_, i) => from + i * 500);
const grid =
  range(Math.ceil(PLAN.minX / 500) * 500, maxX)
    .map((x) => `M${x} ${PLAN.minZ}V${maxZ}`)
    .join("") +
  range(Math.ceil(PLAN.minZ / 500) * 500, maxZ)
    .map((z) => `M${PLAN.minX} ${z}H${maxX}`)
    .join("");
---

<section id="frankfurt" class="border-line border-t py-24 md:py-36">
  <div class="wrap">
    <SectionHead n={4} eyebrow={t.eyebrow} heading={t.heading} />

    <div class="mt-14 grid gap-x-8 gap-y-12 md:mt-20 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <p class="lede">{t.body}</p>
        <dl class="facts mt-10">
          {
            facts.map(([label, value]) => (
              <div>
                <dt class="label">{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <figure class="lg:col-span-6 lg:col-start-7" data-reveal style="--i:1">
        <!-- Where the city model can run, it takes over the sheet (src/three) and the drawing stays hidden. -->
        <div class="plan" data-stage="plan">
          <div class="plan__model" data-stage-canvas></div>
          <svg
            class="plan__drawing"
            viewBox={`${PLAN.minX} ${PLAN.minZ} ${PLAN.width} ${PLAN.height}`}
            role="img"
            aria-label={t.figureAlt}>
            <path class="plan__grid" d={grid}></path>
            <path class="plan__river" d={plan.river}></path>
            <path class="plan__buildings" d={plan.footprints}></path>
            <!-- Scale bar: 1 km. -->
            <path class="plan__scale" d={`M${PLAN.minX + 300} ${maxZ - 400}v85h1000v-85m-500 25v60`}></path>
          </svg>
          <div class="plan__tags" data-stage-overlay>
            <span class="pin" style={`left:${left(pin[0])};top:${top(pin[1])}`}>
              <i aria-hidden="true"></i>
              <span class="pin__label"><b>May Solutions</b><span>Riedberg</span></span>
            </span>
            <span class="tag" style={`left:${left(-1690)};top:${top(-215)}`}>{t.plan.fair}</span>
            <span class="tag" style={`left:${left(420)};top:${top(-330)}`}>{t.plan.banks}</span>
            <span class="tag tag--river" style={`left:${left(-330)};top:${top(1520)}`}>{t.plan.river}</span>
            <span class="tag" style={`left:${left(PLAN.minX + 300)};top:${top(maxZ - 230)}`}>1 km</span>
            <span class="tag tag--north" style={`left:${left(maxX - 550)};top:${top(maxZ - 1000)}`}>
              <svg viewBox="0 0 16 22" aria-hidden="true"><path d="M8 21V2M3 8l5-6 5 6"></path></svg>
              {t.plan.north}
            </span>
          </div>
        </div>
        <figcaption class="label mt-3">{t.figure}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .facts > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--color-line);
  }
  .facts > div:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .facts dd {
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .plan {
    position: relative;
    border: 1px solid var(--color-ink);
    overflow: hidden;
  }
  .plan > svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .plan__model {
    position: absolute;
    inset: 0;
    display: none;
  }
  .plan__tags {
    pointer-events: none;
  }
  :global(.gl) .plan__model {
    display: block;
  }
  :global(.gl) .plan__drawing {
    visibility: hidden;
  }
  /* The model's roofs are inked in, so the names on top of them need a paper backing. */
  :global(.gl) .plan__tags .tag:not(.tag--north) {
    padding: 0.25rem 0.375rem;
    margin: -0.25rem -0.375rem;
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
  }
  .plan path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .plan__grid {
    stroke: var(--color-line);
    stroke-width: 1;
    stroke-opacity: 0.6;
  }
  /* The Main, at roughly its real width (the stroke is in metres here, so it scales with the plan). */
  .plan .plan__river {
    stroke: color-mix(in srgb, var(--color-ink) 9%, var(--color-surface));
    stroke-width: 130;
    stroke-linejoin: round;
    vector-effect: none;
  }
  .plan .plan__buildings {
    fill: var(--color-ink);
  }
  .plan__scale {
    stroke: var(--color-ink);
    stroke-width: 1;
  }

  /* Riedberg: the company's pin, with a slow ring around it. */
  .pin {
    position: absolute;
  }
  .pin i,
  .pin i::after {
    position: absolute;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    translate: -50% -50%;
  }
  .pin i {
    background: var(--color-redline);
    box-shadow: 0 0 0 3px var(--color-surface);
  }
  .pin i::after {
    content: "";
    top: 50%;
    left: 50%;
    border: 1px solid var(--color-redline);
    animation: pin-ring 2.4s var(--ease-out-expo) infinite;
  }
  @keyframes pin-ring {
    from {
      scale: 1;
      opacity: 1;
    }
    to {
      scale: 3.2;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pin i::after {
      animation: none;
      scale: 2;
    }
  }
  .pin__label {
    position: absolute;
    left: 1rem;
    top: 0;
    translate: 0 -50%;
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
    padding: 0.3125rem 0.4375rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-muted);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
  }
  .pin__label b {
    font-weight: 500;
    color: var(--color-redline);
  }

  .tag {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .tag--river {
    color: var(--color-muted);
    letter-spacing: 0.4em;
  }
  .tag--north {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
  }
  .tag--north svg {
    width: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
  }
</style>
