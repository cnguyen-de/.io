---
// The whole home page for one language. src/pages/index.astro (en) and src/pages/de/index.astro render it.
import { translations, type Locale } from "../i18n";
import Layout from "../layouts/Layout.astro";
import { structuredData } from "../lib/seo";
import Clients from "./Clients.astro";
import Contact from "./Contact.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Location from "./Location.astro";
import Services from "./Services.astro";
import Stack from "./Stack.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { meta } = translations[lang];
---

<Layout lang={lang} title={meta.title} description={meta.description} translated model jsonLd={structuredData(lang)}>
  <span id="top"></span>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Clients lang={lang} />
    <Services lang={lang} />
    <Stack lang={lang} />
    <Location lang={lang} />
  </main>
  <Contact lang={lang} />
</Layout>

<script>
  // The city model is an enhancement: it loads after the page, and only where the head script
  // found WebGL (html.gl). If it cannot start, the static drawings come back.
  const root = document.documentElement;
  const stages = [...document.querySelectorAll<HTMLElement>("[data-stage]")];
  if (root.classList.contains("gl") && stages.length) {
    import("../three/engine")
      .then(({ Engine }) => new Engine(stages).start())
      .catch((error) => {
        console.warn("City model unavailable, showing the static drawings.", error);
        root.classList.remove("gl");
      });
  }
</script>
