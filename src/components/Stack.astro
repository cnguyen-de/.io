---
import { STACK } from "../data/stack";
import icons from "../data/tech-icons.json";
import { translations, type Locale } from "../i18n";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Locale;
}

const t = translations[Astro.props.lang].stack;
const techIcons: Record<string, string> = icons;
---

<section id="stack" class="py-24 md:py-36">
  <div class="wrap">
    <SectionHead n={3} eyebrow={t.eyebrow} heading={t.heading} body={t.body} />

    <div class="groups mt-14 md:mt-20">
      {
        STACK.map((g, i) => (
          <section class="group" data-reveal style={`--i:${i}`}>
            <h3 class="label flex justify-between">
              {t.groups[g.id]}
              <span>{String(g.items.length).padStart(2, "0")}</span>
            </h3>
            <ul>
              {g.items.map(([slug, name]) => (
                <li class="item">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d={techIcons[slug]} />
                  </svg>
                  {name}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.25rem;
  }
  .group {
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-ink);
  }
  .group ul {
    margin-top: 1.25rem;
  }
  .item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.4375rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    transition:
      color 0.25s,
      transform 0.4s var(--ease-out-expo);
  }
  .item svg {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    fill: currentColor;
    opacity: 0.85;
  }
  @media (hover: hover) {
    .item:hover {
      color: var(--color-redline);
      transform: translateX(0.375rem);
    }
  }
  @media (min-width: 768px) {
    .groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem 2rem;
    }
  }
  @media (min-width: 1100px) {
    .groups {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
