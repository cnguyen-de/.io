---
// Every section opens the same way: sheet number and name, a display heading, and a short aside.
interface Props {
  n: number;
  eyebrow: string;
  heading: string;
  body?: string;
}
const { n, eyebrow, heading, body } = Astro.props;
---

<header class="grid gap-x-8 gap-y-6 md:grid-cols-12 md:items-end">
  <p class="label md:col-span-12" data-reveal>
    <b>{String(n).padStart(2, "0")}</b>&ensp;—&ensp;{eyebrow}
  </p>
  <h2 class="display md:col-span-7" data-reveal style="--i:1">{heading}</h2>
  {
    body && (
      <p
        class="lede max-w-[28rem] md:col-span-5 md:justify-self-end lg:col-span-4 lg:col-start-9"
        data-reveal
        style="--i:2">
        {body}
      </p>
    )
  }
</header>
