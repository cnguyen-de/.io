---
import { CLIENTS } from "../data/clients";
import { translations, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const t = translations[Astro.props.lang].trusted;
---

<!-- A compact strip under the hero: the names alone, each one links to the client. -->
<section id="clients" class="clients">
  <div class="wrap strip">
    <h2 class="label">{t.heading}</h2>
    <ul>
      {
        CLIENTS.map((c) => (
          <li>
            <a
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${c.name}, ${t.sectors[c.id]} (${t.visit})`}>
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .clients {
    border-block: 1px solid var(--color-line);
  }
  .strip {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 4rem);
    padding-block: 1.65rem;
  }
  h2 {
    flex: none;
  }
  ul {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  a {
    display: inline-block;
    font-size: clamp(1rem, 1.6vw, 1.5rem);
    font-weight: 540;
    letter-spacing: -0.04em;
    text-decoration: underline 1px transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s;
  }
  a:hover {
    text-decoration-color: var(--color-redline);
  }

  @media (max-width: 780px) {
    .strip {
      display: block;
    }
    ul {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem 0.5rem;
      margin-top: 1rem;
    }
  }
  @media (max-width: 420px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
