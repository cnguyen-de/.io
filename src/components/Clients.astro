---
import { CLIENTS } from "../data/clients";
import { translations, type Locale } from "../i18n";
import Arrow from "./Arrow.astro";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Locale;
}

const t = translations[Astro.props.lang].trusted;
---

<section id="clients" class="py-24 md:py-36">
  <div class="wrap">
    <SectionHead n={1} eyebrow={t.eyebrow} heading={t.heading} body={t.body} />

    <!-- The names are the headline: one row each, the whole row is the link. -->
    <ol class="mt-14 md:mt-20">
      {
        CLIENTS.map((c, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              class="row"
              aria-label={`${c.name} — ${t.sectors[c.id]} (${t.visit})`}>
              <span class="row__n">{String(i + 1).padStart(2, "0")}</span>
              <span class="row__name">{c.name}</span>
              <span class="row__sector">{t.sectors[c.id]}</span>
              <Arrow dir="out" class="row__arrow" />
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  ol {
    border-bottom: 1px solid var(--color-line);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem 1fr 1.25rem;
    align-items: baseline;
    column-gap: 0.5rem;
    padding: 1.375rem 0 1.125rem;
    border-top: 1px solid var(--color-line);
    isolation: isolate;
    transition: color 0.35s;
  }
  /* On hover the row is inked in from below and the text flips to paper. */
  .row::before {
    content: "";
    position: absolute;
    inset: 0 calc(clamp(1.25rem, 4.5vw, 4rem) * -0.5);
    z-index: -1;
    background: var(--color-ink);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.5s var(--ease-out-expo);
  }
  .row__n,
  .row__sector {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 0.35s;
  }
  .row__name {
    font-size: clamp(1.875rem, 5.2vw, 4.5rem);
    line-height: 1;
    font-weight: 540;
    letter-spacing: -0.045em;
    transition: transform 0.5s var(--ease-out-expo);
  }
  .row__sector {
    grid-column: 2;
    margin-top: 0.5rem;
  }
  .row :global(.row__arrow) {
    grid-column: 3;
    grid-row: 1;
    align-self: center;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-muted);
    transition:
      color 0.35s,
      transform 0.5s var(--ease-out-expo);
  }

  @media (min-width: 768px) {
    .row {
      grid-template-columns: 4rem 1fr auto 3rem;
      column-gap: 1.5rem;
      padding: 2rem 0 1.5rem;
    }
    .row__sector {
      grid-column: 3;
      margin-top: 0;
    }
    .row :global(.row__arrow) {
      grid-column: 4;
      justify-self: end;
      width: 1.75rem;
      height: 1.75rem;
    }
  }

  @media (hover: hover) {
    .row:hover {
      color: var(--color-surface);
    }
    .row:hover::before {
      transform: scaleY(1);
    }
    .row:hover .row__name {
      transform: translateX(0.75rem);
    }
    .row:hover .row__n {
      color: var(--color-redline);
    }
    .row:hover .row__sector {
      color: color-mix(in srgb, var(--color-surface) 70%, transparent);
    }
    .row:hover :global(.row__arrow) {
      color: var(--color-surface);
      transform: translateX(0.3rem);
    }
  }
</style>
