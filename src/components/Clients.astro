---
import { CLIENTS } from "../data/clients";
import { translations, type Locale } from "../i18n";
interface Props {
  lang: Locale;
}
const t = translations[Astro.props.lang].trusted;
---

<section id="clients" class="clients">
  <div class="wrap strip">
    <h2 class="label">{t.heading}</h2>
    <ul>
      {
        CLIENTS.map((c) => (
          <li>
            <a
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              class={c.id}
              aria-label={`${c.name}, ${t.sectors[c.id]} (${t.visit})`}>
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
<style>
  .clients {
    border-block: 1px solid var(--color-line);
  }
  .strip {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 4rem);
    padding-block: 1.65rem;
  }
  h2 {
    flex: none;
  }
  ul {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  a {
    display: inline-block;
    color: #455248;
    font-size: clamp(1rem, 1.6vw, 1.55rem);
    font-weight: 620;
    letter-spacing: -0.055em;
    transition: color 0.2s;
  }
  a:hover {
    color: #17271c;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .mercedesBenzIo {
    font:
      normal clamp(1rem, 1.6vw, 1.55rem) Georgia,
      serif;
    letter-spacing: -0.055em;
  }
  .lbbw {
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .bilfinger {
    font-weight: 730;
  }
  .thinkcell {
    font-style: italic;
  }
  @media (max-width: 780px) {
    .strip {
      display: block;
    }
    ul {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 1rem;
      gap: 1rem 0.5rem;
    }
  }
  @media (max-width: 420px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
