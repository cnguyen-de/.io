---
import { featuredWork } from "../data/featured-work";
import { translations, type Locale } from "../i18n";
import Arrow from "./Arrow.astro";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Locale;
}

const project = featuredWork.copy[Astro.props.lang];
const t = translations[Astro.props.lang].work;
---

<section id="work" class="py-24 md:py-36">
  <div class="wrap">
    <SectionHead n={1} eyebrow={t.eyebrow} heading={t.heading} />

    <article class="mt-14 md:mt-20" data-reveal>
      {
        featuredWork.image ? (
          <img class="figure" src={featuredWork.image} alt={project.imageAlt ?? ""} loading="lazy" />
        ) : (
          // Until there is a screenshot: a stack of drawing sheets on the paper grid.
          <div class="figure preview" aria-hidden="true">
            <div class="sheets">
              <i />
              <i />
              <i />
            </div>
          </div>
        )
      }
      <div class="copy">
        <h3>{project.title}</h3>
        <p class="lede mt-4">{project.description}</p>
        {
          featuredWork.url && (
            <a class="btn mt-8" href={featuredWork.url}>
              {t.open}
              <Arrow dir="out" />
            </a>
          )
        }
      </div>
    </article>
  </div>
</section>

<style>
  article {
    display: grid;
    border-block: 1px solid var(--color-line);
  }
  .figure {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-bottom: 1px solid var(--color-line);
  }
  .preview {
    min-height: 13rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    background-image:
      linear-gradient(var(--color-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px);
    background-size: 2rem 2rem;
    background-position: center;
  }
  .sheets {
    position: relative;
    width: 9rem;
    height: 9rem;
    transform: rotate(-32deg) skew(18deg, 8deg) scaleY(0.77);
  }
  i {
    position: absolute;
    inset: 0;
    border: 1px solid var(--color-ink);
    background: var(--color-surface);
    transform: translate(-1.5rem, 2.5rem);
  }
  i:nth-child(2) {
    transform: translate(-0.75rem, 1.25rem);
  }
  i:last-child {
    transform: none;
    border-color: var(--color-redline);
    background:
      repeating-linear-gradient(90deg, transparent 0 12px, var(--color-line) 12px 13px), var(--color-surface);
  }
  .copy {
    align-self: center;
    padding-block: 2rem;
  }
  h3 {
    font-size: clamp(1.75rem, 3.3vw, 3rem);
    line-height: 1.04;
    font-weight: 540;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    article {
      grid-template-columns: 7fr 5fr;
    }
    .figure {
      border-bottom: 0;
      border-right: 1px solid var(--color-line);
    }
    .preview {
      min-height: 18rem;
    }
    .copy {
      padding: 3rem clamp(2rem, 4vw, 4rem);
    }
  }
</style>
