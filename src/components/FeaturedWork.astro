---
import { PROJECTS } from "../data/featured-work";
import { translations, type Locale } from "../i18n";
import Arrow from "./Arrow.astro";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang].work;
---

<section id="work" class="py-24 md:py-36">
  <div class="wrap">
    <SectionHead n={1} eyebrow={t.eyebrow} heading={t.heading} body={t.body} />

    <!-- Laid out like the services: number and kind, the project itself, and its spec sheet. -->
    <div class="mt-14 md:mt-20">
      {
        PROJECTS.map((p, i) => {
          const c = p.copy[lang];
          return (
            <article class="project">
              <header class="project__head" data-reveal>
                <span class="project__n">{String(i + 1).padStart(2, "0")}</span>
                <p class="label">{c.kind}</p>
              </header>

              <div data-reveal style="--i:1">
                <h3 class="project__name">{p.name}</h3>
                <p class="lede mt-5 max-w-[34rem]">{c.body}</p>
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group mt-6 inline-flex items-center gap-2 text-[0.9375rem] font-medium"
                  aria-label={`${p.name} (${t.visit})`}>
                  <span class="link">{new URL(p.url).host}</span>
                  <Arrow dir="out" class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5" />
                </a>
              </div>

              <dl class="project__spec" data-reveal style="--i:2">
                {c.rows.map(([label, detail]) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{detail}</dd>
                  </div>
                ))}
              </dl>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .project {
    display: grid;
    gap: 1.75rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--color-line);
  }
  .project:last-child {
    padding-bottom: 0;
  }
  .project__head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .project__n {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--color-redline);
  }
  .project__name {
    font-size: clamp(1.75rem, 3.3vw, 3rem);
    line-height: 1.04;
    font-weight: 540;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .project__spec {
    align-self: start;
    border-bottom: 1px solid var(--color-line);
  }
  .project__spec > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--color-line);
  }
  .project__spec dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .project__spec dd {
    font-size: 0.9375rem;
    line-height: 1.4;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .project {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      padding-block: 3.5rem;
    }
    .project__head {
      grid-column: span 2;
      flex-direction: column;
      gap: 0.75rem;
    }
    .project > div {
      grid-column: span 6;
    }
    .project__spec {
      grid-column: span 4;
    }
  }
</style>
