---
import "../styles/global.css";
import { HOME, type Locale } from "../i18n";
import { CITY } from "../lib/geo";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Pages that exist in both languages announce each other and may forward by browser language. */
  translated?: boolean;
}

const { lang, title, description, translated = false } = Astro.props;

const siteName = "May Solutions";
const siteUrl = "https://may-solutions.io";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = `${siteUrl}/og-image.png`;

const forwardGerman = `try{var l=localStorage.getItem("locale")||((navigator.language||"").toLowerCase().indexOf("de")===0?"de":"en");if(l==="de")location.replace("${HOME.de}"+location.hash)}catch(e){}`;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "May Solutions UG (haftungsbeschränkt)",
  alternateName: "May Solutions",
  description:
    "Softwareentwicklung und IT-Beratung in Frankfurt am Main. Individuelle Softwarelösungen für Unternehmen im Mittelstand.",
  url: siteUrl,
  // No email, street address or office coordinates here: structured data is read by bots first.
  address: {
    "@type": "PostalAddress",
    addressLocality: "Frankfurt am Main",
    addressRegion: "Hessen",
    addressCountry: "DE"
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: CITY.lat,
    longitude: CITY.lon
  },
  areaServed: [
    { "@type": "City", name: "Frankfurt am Main" },
    { "@type": "State", name: "Hessen" },
    { "@type": "Country", name: "Deutschland" }
  ],
  serviceType: ["Softwareentwicklung", "IT-Beratung", "Webentwicklung", "Digitalisierungsberatung", "IT-Consulting"],
  priceRange: "$$",
  knowsLanguage: ["de", "en"],
  founder: {
    "@type": "Person",
    name: "Minh Chi Nguyen"
  },
  legalName: "May Solutions UG (haftungsbeschränkt)"
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f2ed" />

    <!-- Marks the document as scripted (enables scroll reveals) before first paint. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {/* First visit in a German browser, or German chosen earlier: continue on the German page. */}
    {translated && lang === "en" && <script is:inline set:html={forwardGerman} />}

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta
      name="keywords"
      content="Softwareentwicklung Frankfurt, IT Beratung Frankfurt, Webentwicklung Frankfurt, Digitalisierung Mittelstand, IT Consulting Frankfurt, individuelle Software Frankfurt, Webentwicklung Agentur Frankfurt"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
    {translated && <meta property="og:locale:alternate" content={lang === "de" ? "en_US" : "de_DE"} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Geo tags for local SEO -->
    <meta name="geo.region" content="DE-HE" />
    <meta name="geo.placename" content="Frankfurt am Main" />
    <meta name="geo.position" content={`${CITY.lat};${CITY.lon}`} />
    <meta name="ICBM" content={`${CITY.lat}, ${CITY.lon}`} />

    <!-- Hreflang -->
    {
      translated && (
        <>
          <link rel="alternate" hreflang="en" href={siteUrl + HOME.en} />
          <link rel="alternate" hreflang="de" href={siteUrl + HOME.de} />
          <link rel="alternate" hreflang="x-default" href={siteUrl + HOME.en} />
        </>
      )
    }

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <!-- Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="65f48548-1b3a-4e69-901b-3ebb92c754eb"
    ></script>
  </head>
  <body class="min-h-dvh">
    <slot />

    <script>
      import { decode } from "../lib/protect";

      // Contact links carry their address encoded (data-mail). It is only turned into a mailto:
      // once somebody actually uses the page, which scrapers do not do.
      let unlocked = false;
      const unlock = () => {
        if (unlocked) return;
        unlocked = true;
        document.querySelectorAll<HTMLAnchorElement>("a[data-mail]").forEach((a) => {
          a.href = `mailto:${decode(a.dataset.mail!)}`;
        });
      };
      for (const type of ["pointerdown", "pointermove", "touchstart", "keydown", "focusin", "scroll", "click"]) {
        window.addEventListener(type, unlock, { once: true, passive: true, capture: true });
      }

      // Scroll reveal: mark elements as they enter the viewport (styles live in global.css).
      const items = document.querySelectorAll("[data-reveal]");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
      );
      items.forEach((el) => observer.observe(el));

      // Remember an explicit language choice, so the root page stops guessing from the browser.
      document.querySelectorAll<HTMLAnchorElement>("a[data-locale]").forEach((a) =>
        a.addEventListener("click", () => {
          try {
            localStorage.setItem("locale", a.dataset.locale!);
          } catch {}
        })
      );
    </script>
  </body>
</html>
